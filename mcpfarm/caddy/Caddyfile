{
    admin 0.0.0.0:2019
    auto_https off
}

:80, :11459 {
    header Access-Control-Allow-Origin *
    header Access-Control-Allow-Headers "Authorization, Content-Type, Accept, mcp-session-id, X-Admin-Secret"
    header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    header Access-Control-Expose-Headers "mcp-session-id"

    @options method OPTIONS
    handle @options {
        respond "" 204
    }

    handle /health {
        respond "OK" 200
    }

    handle /admin/* {
        reverse_proxy auth-gateway:9090
    }

    # OpenAPI / Swagger UI for the auth-gateway API
    handle /docs* {
        reverse_proxy auth-gateway:9090
    }

    handle /redoc* {
        reverse_proxy auth-gateway:9090
    }

    handle /openapi.json {
        reverse_proxy auth-gateway:9090
    }

    handle /services* {
        reverse_proxy auth-gateway:9090
    }

    handle /ui-config {
        reverse_proxy auth-gateway:9090
    }

    handle /verify {
        reverse_proxy auth-gateway:9090
    }

    handle /claude {
        reverse_proxy auth-gateway:9090
    }

    handle /chat/* {
        reverse_proxy auth-gateway:9090
    }

    handle /vectors/* {
        reverse_proxy auth-gateway:9090
    }

    handle /llm-keys* {
        reverse_proxy auth-gateway:9090
    }

    # Glob import is optional: on a fresh deploy routes.conf does not exist yet
    # (the auth-gateway writes it on seed/admin reload). A non-glob import of a
    # missing file makes Caddy fail to load and crash-loop, deadlocking first boot.
    import /etc/caddy/dynamic/*.conf

    handle {
        reverse_proxy mcpfarm-ui:3000
    }
}
