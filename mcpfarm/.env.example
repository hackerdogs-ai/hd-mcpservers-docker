# ── Farm infrastructure ─────────────────────────────────────
TUNNEL_TOKEN=
ADMIN_SECRET=
AUTH_DB_PATH=/data/auth.db
FARM_PORT=8485

# ── LLM key vault & chat proxy ─────────────────────────────
MCPFARM_SECRETS_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_URL=http://host.docker.internal:11434

# ── Vector search ───────────────────────────────────────────
REDIS_URL=redis://hd-redis:6379
MCPFARM_VECTOR_PREFIX=mcpfarm:v1
MCPFARM_VECTOR_INDEX=mcpfarm:idx
VECTOR_DIM=1536
VECTOR_AUTO_REINDEX=true
EMBED_PROVIDER=auto

# ── Azure / Bedrock (optional) ──────────────────────────────
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
BEDROCK_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# ── Tool-specific API keys ──────────────────────────────────
PDCP_API_KEY=
SHODAN_API_KEY=
CENSYS_API_TOKEN=
VIRUSTOTAL_API_KEY=
BEVIGIL_API_KEY=
ABUSEIPDB_API_KEY=
ABUSECH_API_KEY=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
BRAVE_API_KEY=
EXA_API_KEY=
FOFA_EMAIL=
FOFA_KEY=
HUNTER_API_KEY=
ZOOMEYE_API_KEY=
NETLAS_API_KEY=
