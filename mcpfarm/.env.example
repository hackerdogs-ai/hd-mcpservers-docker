# =============================================================================
# MCP Farm environment configuration
# Copy to .env and fill in only what you need. Empty is fine for optional vars.
# =============================================================================

# -----------------------------------------------------------------------------
# Farm infrastructure
# -----------------------------------------------------------------------------

# Operator password for the farm UI /admin APIs (start/stop, keys, reload).
# Optional for local/interactive use — leave blank, open the UI, click Generate.
# Set this only for production or scripts that call /admin without the UI.
ADMIN_SECRET=

# SQLite path inside the auth-gateway container (leave default).
AUTH_DB_PATH=/data/auth.db

# Host port for the farm UI and MCP routes (default 8485).
FARM_PORT=8485

# -----------------------------------------------------------------------------
# LLM key vault & chat proxy
# -----------------------------------------------------------------------------

# Encrypts Claude/OpenAI/etc. keys you save in Settings (Chat providers).
# Optional. Leave blank — the gateway makes one and stores it on the data volume.
# Set this in production if you care about decrypting those keys after a wipe
# of the volume, or sharing the same vault across hosts.
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MCPFARM_SECRETS_KEY=

# Used for embeddings when EMBED_PROVIDER=openai (or auto and this is set),
# and for the server-side OpenAI chat proxy.
OPENAI_API_KEY=

# Optional Anthropic key for Claude via the chat proxy / vault workflows.
ANTHROPIC_API_KEY=

# Base URL for a local Ollama daemon (embeddings + chat when using ollama).
# host.docker.internal reaches Ollama on the Docker host from containers.
OLLAMA_URL=http://host.docker.internal:11434

# -----------------------------------------------------------------------------
# Vector search (chat tool binding)
# -----------------------------------------------------------------------------
# Redis Stack holds the tool embedding index. Point REDIS_URL at your instance
# (shared hd-redis on network hdnet, or the bundled service in image-only deploys).

REDIS_URL=redis://hd-redis:6379

# Key prefix and RediSearch index name for farm vectors (change only if sharing
# one Redis with multiple farm deployments).
MCPFARM_VECTOR_PREFIX=mcpfarm:v1
MCPFARM_VECTOR_INDEX=mcpfarm:idx

# Embedding vector size. Must match the active embedder (OpenAI text-embedding-3-small
# is 1536). All providers pad/truncate to this dimension.
VECTOR_DIM=1536

# If true, rebuild the vector index from registered servers on gateway startup.
VECTOR_AUTO_REINDEX=true

# Embedding backend for tool search / chat routing.
#   auto   — pick openai if OPENAI_API_KEY is set, else ollama if OLLAMA_URL is
#            set, else local (default)
#   openai — OpenAI text-embedding-3-small (requires OPENAI_API_KEY)
#   ollama — Ollama embed API (requires OLLAMA_URL; default model nomic-embed-text)
#   local  — offline deterministic hasher (no API keys; fine for tests / air-gap)
EMBED_PROVIDER=local

# -----------------------------------------------------------------------------
# Azure OpenAI / AWS Bedrock (optional chat providers)
# -----------------------------------------------------------------------------

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
BEDROCK_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# -----------------------------------------------------------------------------
# Tool-specific API keys
# -----------------------------------------------------------------------------
# Only needed for MCP tools you actually start. See port-map.json `env` arrays
# for the full per-tool list; common ones:

PDCP_API_KEY=
SHODAN_API_KEY=
CENSYS_API_TOKEN=
VIRUSTOTAL_API_KEY=
BEVIGIL_API_KEY=
ABUSEIPDB_API_KEY=
ABUSECH_API_KEY=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
BRAVE_API_KEY=
EXA_API_KEY=
FOFA_EMAIL=
FOFA_KEY=
HUNTER_API_KEY=
ZOOMEYE_API_KEY=
NETLAS_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
